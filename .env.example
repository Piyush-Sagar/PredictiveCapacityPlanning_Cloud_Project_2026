# Backend (capplan_api) — defaults shown. Copy to .env for `make dev`.
DATABASE_URL=sqlite:///./capplan-dev.db
COGNITO_ISSUER=http://localhost:9229/us-east-1_CapPlanDemo
COGNITO_PUBLIC_URL=http://localhost:9229
FRONTEND_URL=http://localhost:3000
SIM_TICK_SECONDS=10
SIM_START=2026-09-28T14:30:00Z

# Fake AWS endpoint (moto). Dummy credentials — never real ones.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# Frontend (src/frontend) — set in its environment.
NEXT_PUBLIC_DATA_MODE=live
BACKEND_URL=http://localhost:8000
COGNITO_INTERNAL_URL=http://localhost:9229
APP_URL=http://localhost:3000

# ⌘K assistant (optional). Without a key it answers in offline mode.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-sante:free
